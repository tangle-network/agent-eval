{
  "name": "@tangle-network/agent-eval",
  "version": "0.133.3",
  "description": "Evaluate and improve AI agents from runs, traces, judges, and feedback. Compare candidates, cluster failures, measure lift, and gate releases.",
  "homepage": "https://github.com/tangle-network/agent-eval#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tangle-network/agent-eval.git"
  },
  "bugs": {
    "url": "https://github.com/tangle-network/agent-eval/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./profile-cell": {
      "types": "./dist/profile-cell.d.ts",
      "import": "./dist/profile-cell.js",
      "default": "./dist/profile-cell.js"
    },
    "./analyst": {
      "types": "./dist/analyst/index.d.ts",
      "import": "./dist/analyst/index.js",
      "default": "./dist/analyst/index.js"
    },
    "./control": {
      "types": "./dist/control.d.ts",
      "import": "./dist/control.js",
      "default": "./dist/control.js"
    },
    "./reporting": {
      "types": "./dist/reporting.d.ts",
      "import": "./dist/reporting.js",
      "default": "./dist/reporting.js"
    },
    "./rl": {
      "types": "./dist/rl.d.ts",
      "import": "./dist/rl.js",
      "default": "./dist/rl.js"
    },
    "./fuzz": {
      "types": "./dist/fuzz.d.ts",
      "import": "./dist/fuzz.js",
      "default": "./dist/fuzz.js"
    },
    "./traces": {
      "types": "./dist/traces.d.ts",
      "import": "./dist/traces.js",
      "default": "./dist/traces.js"
    },
    "./trace-attributes": {
      "types": "./dist/trace-attributes.d.ts",
      "import": "./dist/trace-attributes.js",
      "default": "./dist/trace-attributes.js"
    },
    "./wire": {
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "default": "./dist/wire/index.js"
    },
    "./benchmarks": {
      "types": "./dist/benchmarks/index.d.ts",
      "import": "./dist/benchmarks/index.js",
      "default": "./dist/benchmarks/index.js"
    },
    "./pipelines": {
      "types": "./dist/pipelines/index.d.ts",
      "import": "./dist/pipelines/index.js",
      "default": "./dist/pipelines/index.js"
    },
    "./meta-eval": {
      "types": "./dist/meta-eval/index.d.ts",
      "import": "./dist/meta-eval/index.js",
      "default": "./dist/meta-eval/index.js"
    },
    "./builder-eval": {
      "types": "./dist/builder-eval/index.d.ts",
      "import": "./dist/builder-eval/index.js",
      "default": "./dist/builder-eval/index.js"
    },
    "./matrix": {
      "types": "./dist/matrix/index.d.ts",
      "import": "./dist/matrix/index.js",
      "default": "./dist/matrix/index.js"
    },
    "./multishot": {
      "types": "./dist/multishot/index.d.ts",
      "import": "./dist/multishot/index.js",
      "default": "./dist/multishot/index.js"
    },
    "./campaign": {
      "types": "./dist/campaign/index.d.ts",
      "import": "./dist/campaign/index.js",
      "default": "./dist/campaign/index.js"
    },
    "./ledger-core": {
      "types": "./dist/ledger-core/index.d.ts",
      "import": "./dist/ledger-core/index.js",
      "default": "./dist/ledger-core/index.js"
    },
    "./storyboard": {
      "types": "./dist/storyboard/index.d.ts",
      "import": "./dist/storyboard/index.js",
      "default": "./dist/storyboard/index.js"
    },
    "./authenticity": {
      "types": "./dist/authenticity/index.d.ts",
      "import": "./dist/authenticity/index.js",
      "default": "./dist/authenticity/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js",
      "default": "./dist/contract/index.js"
    },
    "./rollout": {
      "types": "./dist/rollout/index.d.ts",
      "import": "./dist/rollout/index.js",
      "default": "./dist/rollout/index.js"
    },
    "./supervisor-run": {
      "types": "./dist/supervisor-run/index.d.ts",
      "import": "./dist/supervisor-run/index.js",
      "default": "./dist/supervisor-run/index.js"
    },
    "./hosted": {
      "types": "./dist/hosted/index.d.ts",
      "import": "./dist/hosted/index.js",
      "default": "./dist/hosted/index.js"
    },
    "./openapi.json": {
      "default": "./dist/openapi.json"
    }
  },
  "bin": {
    "agent-eval": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm openapi",
    "dev": "tsdown --watch",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "lint": "biome check src",
    "format": "biome format --write src",
    "check:skill": "node scripts/check-skill.mjs",
    "openapi": "node dist/cli.js openapi --out dist/openapi.json",
    "verify:package": "pnpm run check:skill && publint && attw --pack --profile esm-only . && node scripts/verify-package-exports.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@ax-llm/ax": "^23.0.5",
    "@hono/node-server": "^2.0.12",
    "@tangle-network/agent-core": "0.4.25",
    "@tangle-network/agent-interface": "0.36.0",
    "hono": "^4.12.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lib-r-math.js": "^3.0.2",
    "lint-staged": "^17.2.0",
    "openapi3-ts": "^4.6.0",
    "oxc-parser": "^0.141.0",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "minimumReleaseAge": 4320,
    "minimumReleaseAgeExclude": [
      "esbuild",
      "vite"
    ],
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "postcss@<8.5.18": "^8.5.18",
      "vite@>=7.0.0 <=7.3.4": "^7.3.5",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "tests/**/*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "license": "MIT",
  "packageManager": "pnpm@10.34.5"
}
