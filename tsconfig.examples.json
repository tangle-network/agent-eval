{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "rootDir": ".",
    "sourceMap": false,
    "paths": {
      "@tangle-network/agent-eval": ["./src/index.ts"],
      "@tangle-network/agent-eval/*": ["./src/*/index.ts"]
    }
  },
  "include": ["examples/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
