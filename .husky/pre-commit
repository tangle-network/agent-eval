# The global commit-time ratchets (size, doc paths, duplicate exports); older hosts have only loc-ratchet.
g="$(git config --global core.hooksPath || true)"
r="$g/ratchets"; [ -x "$r" ] || r="$g/loc-ratchet"
if [ -x "$r" ]; then
  "$r" || exit "$?"
fi

pnpm exec lint-staged
pnpm typecheck
node scripts/check-analyst-benchmark-implementation.mjs --source-only
