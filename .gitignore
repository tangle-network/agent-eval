node_modules/
dist/
.env
*.tsbuildinfo

# Claude Code runtime artifacts (not part of repo state)
.claude/scheduled_tasks.lock

# Python clients (venvs + bytecode caches should never enter git)
.venv/
**/__pycache__/
*.pyc
*.pyo

# Local dev session storage
data/

# Test + run ephemerals
.agent/
.runs/
.marketing-agent-runs/
.calibrate/
coverage/
*.junit.xml
*.log
*.tgz
.evolve/

# Throwaway working files. Never a deliverable.
.scratch/
scratchpad/

# SQLite opens the committed opencode.db fixture in WAL mode and leaves these beside it after a test run
tests/fixtures/**/*.db-shm
tests/fixtures/**/*.db-wal
