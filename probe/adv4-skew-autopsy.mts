/**
 * ROUND-4 ADVERSARY PROBE E — autopsy of probe D, plus the differential against
 * origin/main and published 0.125.0 on the same draws, plus a TRUE-REGRESSION
 * cell (not just the exact null).
 *
 * `probe/gate-main.ts` is generated by `probe/setup-main-gate.sh` (origin/main's
 * gate). Published 0.125.0 comes from the supervisor-lab node_modules.
 */
import { HeldOutGate } from '../src/held-out-gate'
import { HeldOutGate as MainGate } from './gate-main'
import { build } from './fixtures'

// biome-ignore lint/suspicious/noExplicitAny: cross-version comparison
const published: any = await import(
  '/home/drew/code/supervisor-lab/.claude/worktrees/profile-kb-arena/node_modules/.pnpm/@tangle-network+agent-eval@0.125.0_typescript@6.0.3/node_modules/@tangle-network/agent-eval/dist/index.js'
)

function lcg(seed: number) {
  let s = seed >>> 0
  return () => {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0
    return s / 4294967296
  }
}

const JITTER = 1e-4

type Cell = { label: string; q: number; win: number; loss: number }
const cells: Cell[] = [
  { label: 'H0 exact   q=0.05  +0.01 / −0.19', q: 0.05, win: 0.01, loss: -0.19 },
  { label: 'REGRESSION q=0.05  +0.01 / −0.29', q: 0.05, win: 0.01, loss: -0.29 },
  { label: 'REGRESSION q=0.05  +0.01 / −0.59', q: 0.05, win: 0.01, loss: -0.59 },
]

const REPS = 2000
const n = 26

// biome-ignore lint/suspicious/noExplicitAny: cross-version comparison
function verdict(Gate: any, before: number[], after: number[], rep: number): boolean {
  const { candidate, baseline } = build(before, after)
  return new Gate({
    baselineKey: 'base',
    pairedDeltaThreshold: 0,
    confidence: 0.95,
    seed: 4242 + rep,
    overfitGapThreshold: 1e9,
  }).evaluate(candidate, baseline).promote
}

console.log(`n=${n}, threshold 0, confidence 0.95, all other defaults, ${REPS} reps per cell.`)
console.log('"zero-loss draws" = samples in which the rare loss never appeared.\n')
console.log(
  'cell                                trueMeanΔ   BRANCH    main0.133  pub0.125   zero-loss draws  promoted∧zero-loss',
)
for (const c of cells) {
  const trueMean = (1 - c.q) * c.win + c.q * c.loss
  let promoted = 0
  let mainPromoted = 0
  let pubPromoted = 0
  let zeroLoss = 0
  let promotedAndZeroLoss = 0
  for (let rep = 0; rep < REPS; rep++) {
    const r = lcg(1000003 * (rep + 1) + n)
    const before: number[] = []
    const after: number[] = []
    let losses = 0
    for (let i = 0; i < n; i++) {
      const isLoss = r() < c.q
      if (isLoss) losses++
      const d = (isLoss ? c.loss : c.win) + (r() - 0.5) * 2 * JITTER
      before.push(0.5)
      after.push(0.5 + d)
    }
    const p = verdict(HeldOutGate, before, after, rep)
    if (p) promoted++
    if (verdict(MainGate, before, after, rep)) mainPromoted++
    if (verdict(published.HeldOutGate, before, after, rep)) pubPromoted++
    if (losses === 0) {
      zeroLoss++
      if (p) promotedAndZeroLoss++
    }
  }
  console.log(
    `${c.label.padEnd(35)} ${trueMean.toFixed(4).padStart(8)}   ` +
      `${((promoted / REPS) * 100).toFixed(1).padStart(5)}%   ` +
      `${((mainPromoted / REPS) * 100).toFixed(1).padStart(6)}%   ` +
      `${((pubPromoted / REPS) * 100).toFixed(1).padStart(6)}%   ` +
      `${String(zeroLoss).padStart(10)}      ${String(promotedAndZeroLoss).padStart(10)}`,
  )
}
console.log(`\nP(no loss in ${n} draws at q=0.05) = 0.95^${n} = ${(0.95 ** n * 100).toFixed(1)}%`)
